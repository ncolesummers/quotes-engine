# Instagram Graph API (see docs/instagram-setup.md).
# The token is read from the macOS Keychain (service "quotes-engine", account "ig-access-token").
# Alternatively, set it from 1Password and run commands under `op run --env-file=.env -- bun ...`:
# IG_ACCESS_TOKEN="op://Development/quotes-engine Instagram/credential"
IG_USER_ID=17841407547014534
IG_GRAPH_HOST=https://graph.facebook.com
# Optional overrides
QUOTES_DB_PATH=data/quotes.db
