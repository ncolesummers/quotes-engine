{
  "name": "quotes-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "import:extractions": "bun scripts/import-extractions.ts",
    "extract:batches": "bun scripts/extraction-batches.ts",
    "ocr": "bun scripts/ocr.ts",
    "extract:classify-batches": "bun scripts/classification-batches.ts",
    "extract:classify-prompt": "bun scripts/classification-prompt.ts",
    "extract:assemble": "bun scripts/assemble-extractions.ts",
    "extract:new": "bun scripts/extract-new.ts",
    "docs:prompt": "bun scripts/extraction-prompt.ts --doc",
    "dev:seed": "bun scripts/dev-seed.ts",
    "sync:instagram": "bun scripts/sync-instagram.ts",
    "books:backfill": "bun scripts/books-backfill.ts",
    "books:rekey": "bun scripts/books-rekey.ts",
    "import:books": "bun scripts/import-books.ts",
    "sync": "bun scripts/sync.ts",
    "launchd:install": "bun scripts/launchd.ts install",
    "launchd:uninstall": "bun scripts/launchd.ts uninstall",
    "launchd:status": "bun scripts/launchd.ts status",
    "launchd:render": "bun scripts/launchd.ts render"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
