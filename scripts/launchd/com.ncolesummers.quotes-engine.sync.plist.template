<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly quotes-engine sync (#18). Rendered by `bun run launchd:install`, which fills in the
  {{...}} placeholders with absolute paths and installs it as a per-user LaunchAgent
  (gui domain, so the job can read the login Keychain and the Claude Code login).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{BUN}}</string>
    <string>{{REPO_DIR}}/scripts/sync.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{REPO_DIR}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{PATH}}</string>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>CLAUDE_BIN</key>
    <string>{{CLAUDE_BIN}}</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/sync.err.log</string>
</dict>
</plist>
